#! /bin/bash

###########################################################
# install rpm from within a container and test it

#--------------------------------------------------------------------
# usage function
#

function usage() {
    echo
    echo "Perform lrose rpm install and test"
    echo "Usage:"
    echo "  $scriptName [options below]"
    echo "  -h   :  help"
    echo "  -d   :  turn debugging on"
    echo "  -p ? :  set lrose_pkg"
    echo "          e.g. lrose-core, lrose-radx"
    echo "  -t ? :  set os_type"
    echo "          e.g. oraclelinux"
    echo "  -v ? :  set os_version"
    echo "          e.g. 8"
    echo "  -n ? :  set rpm name"
    echo "  -l ? :  set log name"
    echo
}

scriptName=$(basename $0)

os_type=oraclelinux
os_version=9
lrose_pkg=lrose-core
debug=true
rpm_name=unknown
log_name=unknown

# Parse command line options.
while getopts hdt:p:v:n:l: OPT; do
    case "$OPT" in
        h)
            usage
            exit 0
            ;;
        d)
            debug=true
            ;;
        p)
            lrose_pkg=$OPTARG
            ;;
        t)
            os_type=$OPTARG
            ;;
        v)
            os_version=$OPTARG
            ;;
        n)
            rpm_name=$OPTARG
            ;;
        l)
            log_name=$OPTARG
            ;;
        \?)
            # getopts issues an error message
            echo "Problems with command line usage"
            usage
            exit 1
            ;;
    esac
done

if [ "$debug" == "true" ]
then
  echo "Running $scriptName"
  echo "  performing rpm install"
  echo "    os_type: ${os_type}"
  echo "    os_version: ${os_version}"
  echo "    lrose_pkg: ${lrose_pkg}"
  echo "    rpm_name: ${rpm_name}"
  echo "    log_name: ${log_name}"
fi

# for centos, install epel release

echo "==>> dnf -y update --nogpgcheck"
dnf -y update --nogpgcheck

if [ "$os_version" = 9 ] ; then
  echo "==>> dnf install -y oracle-epel-release-el9"
  dnf install -y oracle-epel-release-el9
elif [ "$os_version" = 10 ] ; then
  echo "==>> dnf install -y oracle-epel-release-el10"
  dnf install -y oracle-epel-release-el10
fi

echo "==>> dnf install -y python"
dnf install -y python

# get the rpm

rpmPath=/pkgDir/${rpm_name}
echo "  ==>>> rpmPath: $rpmPath"
logPath=/pkgDir/${log_name}
echo "  ==>>> logPath: $logPath"

# install the rpm

echo "==>> dnf install --nogpgcheck -y ${rpmPath}"
dnf install --nogpgcheck -y ${rpmPath}

# check that RadxPrint runs

/usr/local/lrose/bin/RadxPrint -h > $logPath 2>&1

# add write permissions since this is created by root
# and we need to remove them from the cross-mount later

chmod o+w -R $logPath
chmod g+w -R $logPath

